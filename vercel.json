{
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/pages/api/[[...path]].ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/pull",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/pull-frequent",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/prospect",
      "schedule": "*/15 * * * *"
    }
  ]
}
