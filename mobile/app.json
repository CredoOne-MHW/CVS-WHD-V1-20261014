{
  "expo": {
    "name": "CredoOne Leads",
    "slug": "credoone-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "credoonelms",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f5c24"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.credoone.lms",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "To attach a photo to a lead or a ticket.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "in.credoone.lms",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f5c24"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "apiBase": "",
      "companyCode": "",
      "companyName": "",
      "primary": "#2f5c24",
      "accent": "#d9b52a",
      "buildVersion": "1.0.0",
      "buildNumber": "1"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f5c24"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#2f5c24",
      "androidMode": "default"
    }
  }
}
