# ──────────────────────────────────────────────────────────────────────────────
# CredoOne LMS — environment variables (v1.3.0)
#
# Copy to .env.local for a local run, or set them in Vercel → Project → Settings →
# Environment Variables for a deployment. Only the four marked REQUIRED are needed
# to boot; everything else switches a feature on.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. One MongoDB cluster; each company gets its own database inside it,
# named after the company code.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# The main (platform) database. Default: leadhive
MONGODB_DB=leadhive
# Connections per serverless instance. Default: 5 — raise only with a dedicated server.
MONGODB_POOL_SIZE=5

# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED. Signs the session cookie. 32+ random characters; changing it signs everyone out.
JWT_SECRET=
# REQUIRED. Encrypts connector tokens, webhook secrets and OAuth tokens at rest.
# Exactly 32 hex characters. Never change it once data exists — the old values cannot be read back.
DATA_ENCRYPTION_KEY=
# Guards /api/cron/* when they are called by hand. Vercel Cron is recognised by its user-agent.
CRON_SECRET=

# ── First sign-in ─────────────────────────────────────────────────────────────
# REQUIRED on the very first boot: creates the Super Admin. Remove them afterwards.
SUPER_ADMIN_EMAIL=operations@credovation.com
SUPER_ADMIN_PASSWORD=

# ── Addresses ─────────────────────────────────────────────────────────────────
# The base each company's address is built on: <company-slug>.<APP_BASE_DOMAIN>
APP_BASE_DOMAIN=mhw.credovation.tech
# Older bases that must keep working (comma-separated).
APP_BASE_DOMAINS=
# Hosts that always show the platform (Super Admin) rather than a company (comma-separated).
PLATFORM_HOSTS=
# Absolute URL of the platform, used in e-mails, webhooks and OAuth callbacks when the
# request's own host cannot be trusted. Falls back to VERCEL_URL.
APP_BASE_URL=https://mhw.credovation.tech
PLATFORM_URL=

# ── File storage (AWS S3) ─────────────────────────────────────────────────────
# Needed for logos, banners, favicons, notification sounds, AI knowledge files,
# client attachments, DPDP documents and mobile app builds.
# Layout per company: <S3_BASE_PATH>/<COMPANY CODE>/branding|app|brain|dpdp|<Client Code>/…
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional root inside the bucket, e.g. lms/prod. Empty = bucket root.
S3_BASE_PATH=
# Optional CDN/base in front of the bucket for public URLs.
S3_PUBLIC_BASE_URL=

# ── Custom domains (Vercel API) ───────────────────────────────────────────────
# Lets Super Admin → Company → Branding & domain add a company's own domain and
# show its DNS records. Without these, the DNS panel explains what to add by hand.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Shared cache (optional, recommended on Vercel) ────────────────────────────
# Without Redis each serverless instance keeps its own small cache, so a change can
# take a few seconds to show everywhere. With it, invalidation is instant.
#
# From v1.3.1 the pair is found by itself, so a store added from the Vercel marketplace
# needs no renaming. Set ONE of these pairs (the first one present wins):
#   UPSTASH_REDIS_REST_URL        + UPSTASH_REDIS_REST_TOKEN        ← set by hand
#   KV_REST_API_URL               + KV_REST_API_TOKEN               ← Vercel KV
#   <STORE>_KV_REST_API_URL       + <STORE>_KV_REST_API_TOKEN       ← Upstash integration
# Super Admin → Settings → System Health shows which one is in use, and warns when none is.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Example of the integration's own names (left as the integration wrote them):
# REDIS_UPSTASH_LIGHTHOUSE_KV_REST_API_URL=
# REDIS_UPSTASH_LIGHTHOUSE_KV_REST_API_TOKEN=
# The read-only token and the redis:// URLs are not used — the cache writes, over REST:
# REDIS_UPSTASH_LIGHTHOUSE_KV_REST_API_READ_ONLY_TOKEN=
# REDIS_UPSTASH_LIGHTHOUSE_KV_URL=
# REDIS_UPSTASH_LIGHTHOUSE_REDIS_URL=

# ── Mobile app builds (v1.5.0) ────────────────────────────────────────────────
# The Android & iOS apps are built by GitHub Actions and the signed files land in
# each company's own S3 folder under <COMPANY CODE>/app/. Knowledge Base → GitHub build
# and the Mobile App tab check each line below and show it green or red.
#
# Repository holding this code and .github/workflows/build-mobile.yml
GITHUB_BUILD_REPO=
# Fine-grained token with "Actions: read and write" on that repository
GITHUB_BUILD_TOKEN=
# Branch to build from; empty = the repository's default branch
GITHUB_BUILD_REF=
# Workflow file name; empty = build-mobile.yml
# GITHUB_BUILD_WORKFLOW=  # ignored from v1.8.4 — this platform always uses build-mobile.yml
# Company builds are numbered <MOBILE_BASE_VERSION>.<n> per company and platform
MOBILE_BASE_VERSION=1.0.0
# Android / iOS application id prefix, e.g. in.credoone.lms → in.credoone.lms.<company>
MOBILE_PACKAGE_PREFIX=
# Set to 1 only after the iOS certificates are in the repository's secrets
MOBILE_IOS_SIGNING=
# Signs the message a finished build sends back. The SAME value must be a secret of
# the build repository, or the platform ignores the result.
# MOBILE_BUILD_SECRET=  # v1.8.1: optional. Leave it out and the platform makes and keeps one, shown on
#                        Super Admin -> Mobile App Release, which can also write it into GitHub for you.
#
# Signing keys are NOT kept here — they live in the repository's GitHub secrets:
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#   IOS_CERT_P12_BASE64, IOS_CERT_PASSWORD, IOS_PROFILE_BASE64, IOS_TEAM_ID (optional)

# ── Platform branding (Super Admin side; a company's own branding is set in the app) ──
PLATFORM_NAME=CredoOne
PLATFORM_TAGLINE=
PLATFORM_THEME=#2b2d72
PLATFORM_ACCENT=
PLATFORM_FOOTER=
NEXT_PUBLIC_BRAND_NAME=CredoOne
NEXT_PUBLIC_PLATFORM_LOGO=

# ── Channel APIs (only if that channel is used) ───────────────────────────────
# Meta Graph and LinkedIn versions are pinned in code; override only to move early.
META_GRAPH_VERSION=
LINKEDIN_VERSION=
# Pull connectors — leave empty to use each provider's standard endpoint.
INDIAMART_API_URL=
TRADEINDIA_API_URL=
# Public web prospecting.
SERPAPI_URL=
BRAVE_API_URL=
BSKY_SERVICE=

# ── Testing only — never set in production ────────────────────────────────────
# Points the channel sign-in flow at a stand-in server instead of Meta/Google/LinkedIn.
OAUTH_MOCK_BASE=
# Allows requests to private/localhost URLs from webhooks and connectors.
ALLOW_PRIVATE_URLS=

# ─────────────────────────────────────────────────────────────────────────────
# v1.6.0 — Chat, push notifications and the scrolling notice
# ─────────────────────────────────────────────────────────────────────────────
# Real-time delivery. Vercel cannot hold a WebSocket open, so a managed service does; the platform only
# publishes to it. Leave ALL of these empty and chat still works — every screen falls back to asking every
# few seconds. Nothing breaks; it is simply not instant.
#
# Pusher (the default). Create a Sandbox app at pusher.com → Channels, cluster ap2 (Mumbai) for India.
REALTIME_PROVIDER=pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
#
# Ably instead of Pusher — set REALTIME_PROVIDER=ably and this one key; nothing else changes.
ABLY_API_KEY=
#
# Push notifications need no key here: each company's app is built with Expo, whose push service holds the
# Google (FCM) and Apple (APNs) credentials. They are created once per app, with the app.

# ─────────────────────────────────────────────────────────────────────────────
# v1.7.0 — Mobile App Release and the platform's own signing keys
# ─────────────────────────────────────────────────────────────────────────────
# Android refuses an update signed with a different key than the installed app, so an app needs ONE key for
# its whole life. With this set, the platform makes one key per company at that company's first Android build
# and signs every later build with it. The keystore and its passwords are encrypted with this before they are
# stored, so the database alone cannot sign anything — keep it, and keep it out of the repository.
#
# Leave it empty and nothing breaks: builds fall back to the build repository's own ANDROID_* secrets, which
# is exactly how v1.5.0 and v1.6.0 worked.
MOBILE_SIGNING_SECRET=
#
# Automatic rebuilds on a push are set up from the screen itself (Super Admin → Mobile App Release), not here.
# The two values it asks you to add in GitHub are PLATFORM_URL (which is APP_BASE_URL, below) and
# BUILD_TRIGGER_SECRET, which the screen makes, shows and can replace.

# ─────────────────────────────────────────────────────────────────────────────
# v1.8.0 — publishing to the stores
# ─────────────────────────────────────────────────────────────────────────────
# Nothing goes here. The two stores are reached by the BUILD, not by the platform, so their credentials are
# repository secrets in GitHub, alongside the ANDROID_* and IOS_* ones:
#
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON   a Play Console service-account key, for the Internal testing track
#   APP_STORE_CONNECT_KEY_ID           \
#   APP_STORE_CONNECT_ISSUER_ID         > an App Store Connect API key, for TestFlight
#   APP_STORE_CONNECT_KEY_P8           /  (the .p8 file, base64-encoded)
#
# All three are optional. Without them a store build still produces the .aab / .ipa and keeps it in the
# company's own S3 folder for you to upload by hand. See Knowledge Base → Publishing to Google Play and the
# App Store for the one-time set-up each store needs first.
