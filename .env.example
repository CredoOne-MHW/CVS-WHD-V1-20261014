# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_DB=leadhive

# ── Auth ───────────────────────────────────────────────────
# long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=

# First Super Admin — created automatically on the first request if none exists yet
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── AWS S3 (knowledge-base files, CSV imports, exports) ────
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── White label ────────────────────────────────────────────
# Super Admin console lives on the base domain; companies get <short-name>.<base>.
# Set it per Vercel environment (Production: mhw.credovation.tech, Preview: dev-mhw.credovation.tech)
# or list both comma-separated. If missing, the base is auto-detected from the address.
APP_BASE_DOMAIN=mhw.credovation.tech,dev-mhw.credovation.tech
# Optional: lets the app add each company's own domain to the Vercel project and
# fetch the exact DNS records + ownership TXT for it (Account Settings › Tokens)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Extra addresses that should always show the Super Admin login (comma-separated, optional)
PLATFORM_HOSTS=
# Platform (Super Admin) login branding
PLATFORM_NAME=CredoOne
PLATFORM_TAGLINE=Lead Management Console
PLATFORM_THEME=#2b2d72
PLATFORM_ACCENT=#6c63ff
NEXT_PUBLIC_PLATFORM_LOGO=/credoone-logo.png

# ── Scale & cache (recommended for production) ─────────────
# Upstash Redis (REST): shared cache + rate limits across all serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mongo connections per serverless instance (keep small; serverless scales out)
MONGODB_POOL_SIZE=5

# ── Optional ───────────────────────────────────────────────
# Public base URL printed on connector cards. Defaults to the request host (so each company sees its own domain).
APP_BASE_URL=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
# 32+ char key used to encrypt connector secrets & webhook headers at rest (falls back to JWT_SECRET)
DATA_ENCRYPTION_KEY=
